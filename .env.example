# Copy this file to .env and fill in your values

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb://127.0.0.1:27017/wpsent

# Port (Railway sets this automatically, default 3000)
PORT=3000

# Single-user mode: set to true to block new registrations after first user
# Perfect for personal use — anyone who tries to register sees a "server full" page
SINGLE_USER=true

# Persistent local profile directory; keep existing value when upgrading.
# Default: <project>/.wwebjs_remote_auth
# WA_REMOTE_AUTH_DIR=/opt/sendwa/WPSent/.wwebjs_remote_auth
WA_AUTH_TIMEOUT_MS=300000
WA_BACKUP_INTERVAL_MS=60000
WA_RECONNECT_MS=5000
WA_STAGGER_MS=3000

# Administrator setup: generate a random token, minimum 32 characters.
# openssl rand -hex 32
# First signup at /admin requires this secret; remove it after setup.
# ADMIN_BOOTSTRAP_TOKEN=
# Public documentation and support details (never put secrets here)
SITE_URL=https://wpsent.xyz
GITHUB_URL=https://github.com/brightbrill-org/WPSent
# INSTAGRAM_URL=https://www.instagram.com/your_handle/
# SUPPORT_EMAIL=support@example.com
CONTRIBUTOR_NAME=WPSent contributors
# SINGLE_USER is only the initial registration policy; admin settings override it.

# Post-authentication recovery (milliseconds)
WA_READY_TIMEOUT_MS=120000
WA_CALLBACK_TIMEOUT_MS=20000
WA_READY_MAX_RETRIES=3
WA_CLOSE_TIMEOUT_MS=30000
