# Copy this file to .env and fill in your values

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb://127.0.0.1:27017/wpsent

# Port (Railway sets this automatically, default 3000)
PORT=3000

# Single-user mode: set to true to block new registrations after first user
# Perfect for personal use — anyone who tries to register sees a "server full" page
SINGLE_USER=true

# Persistent local profile directory; keep existing value when upgrading.
# Default: <project>/.wwebjs_remote_auth
# WA_REMOTE_AUTH_DIR=/opt/sendwa/WPSent/.wwebjs_remote_auth
WA_AUTH_TIMEOUT_MS=300000
WA_BACKUP_INTERVAL_MS=60000
WA_RECONNECT_MS=5000
WA_STAGGER_MS=3000
