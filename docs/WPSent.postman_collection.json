            ],
            "url": "{{baseUrl}}/groups/{{groupId}}/invite",
            "description": "Requires linked WhatsApp account; existing-group actions require group admin. Operates on real groups. Use authorized test participants."
          }
        }
      ]
    }
  ]
}
